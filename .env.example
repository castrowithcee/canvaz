# Vorlage fuer die lokale Konfiguration: `cp .env.example .env` und Platzhalter ersetzen.
# `.env` ist gitignoriert und darf nie versioniert werden.

# Anwendungsserver.
# Die Werte hier gelten fuer die Werkzeuge auf dem Host: Testlauf, Migration und `admin:bootstrap`. Der
# Container aus compose.yml setzt Port, Basis-URL und Datenbankadresse selbst - er erreicht die Datenbank im
# Netz des Stacks und haengt unter seinem Namen am Proxy.
CANVAZ_PORT=3000
# Derselbe Name wie am Proxy: der Einladungslink aus `admin:bootstrap` fuehrt sonst ins Leere.
CANVAZ_BASE_URL=http://canvaz.localhost:27000
CANVAZ_WEB_ROOT=dist/web

# PostgreSQL aus compose.yml (Hostport 55432)
DATABASE_URL=postgres://canvaz:canvaz@127.0.0.1:55432/canvaz

# Serverseitige Sessions. Mindestens 32 Zeichen, z. B. `openssl rand -base64 48`.
CANVAZ_SESSION_SECRET=ERSETZEN-durch-ein-zufaelliges-Geheimnis
CANVAZ_SESSION_TTL_HOURS=12

# Schluessel des zweiten Faktors des Systemadmins (AES-256-GCM fuer das TOTP-Geheimnis, abgeleiteter HMAC
# fuer die Ersatzcodes). Pflichtwert ohne Standard: genau 32 Byte in base64, erzeugen mit
# `openssl rand -base64 32`. Getrennt von der Datenbanksicherung verwahren; bei Verlust oder Wechsel richtet
# der Systemadmin den Faktor nach `npm run admin:recover` neu ein (README, "Zweiter Faktor").
CANVAZ_MFA_ENCRYPTION_KEY=ERSETZEN-durch-32-zufaellige-Byte-in-base64

# OIDC-Anbindung - OPTIONAL. Ohne jede der vier Variablen startet die Instanz und arbeitet allein mit der
# lokalen Benutzerverwaltung. Wer den externen Weg zuschaltet, setzt ALLE vier; eine halbe Konfiguration ist
# ein Startfehler und kein stiller Verzicht.
# Die Redirect-URI muss dieselbe Herkunft wie CANVAZ_BASE_URL haben; sonst startet der Server nicht.
# Authentik: Issuer ist die "OpenID Configuration Issuer"-URL der Application, z. B.
# https://authentik.example.com/application/o/canvaz/
#CANVAZ_OIDC_ISSUER=https://idp.example.com/realms/canvaz
#CANVAZ_OIDC_CLIENT_ID=ERSETZEN-Client-ID
#CANVAZ_OIDC_CLIENT_SECRET=ERSETZEN-Client-Secret
#CANVAZ_OIDC_REDIRECT_URI=http://canvaz.localhost:27000/api/auth/callback

# Postausgang - OPTIONAL. Ohne jede CANVAZ_SMTP_*-Variable und ohne CANVAZ_MAIL_FROM verschickt die Instanz
# nichts; ein Einladungslink steht dann wie bisher genau einmal in der Antwort der Anlage und wird von Hand
# zugestellt. Sobald eine der Variablen gesetzt ist, gelten Server und Absender als gewollt: fehlt einer,
# ist das ein Startfehler.
# Verschickt werden: die Einladung mit ihrem Link, die Mitteilung ueber eine administrative
# Passwortruecksetzung (ohne das neue Passwort) und an den Systemadmin Mitteilungen ueber Aenderungen seines
# zweiten Faktors und ueber `admin:recover` (ohne Geheimnis, Code oder Link).
# CANVAZ_SMTP_PORT ist ohne Angabe 587. CANVAZ_SMTP_SECURE (implizites TLS) folgt dem Port: 465 ja, sonst
# nein - dort ist STARTTLS Pflicht, ohne es bricht der Versand ab. CANVAZ_SMTP_ALLOW_INSECURE=true hebt die
# Pflicht auf, ausschliesslich fuer einen isolierten lokalen Relay im selben vertrauenswuerdigen Netz.
# Benutzer und Passwort gehoeren zusammen oder entfallen beide; ein Postausgang im eigenen Netz verlangt
# haeufig keine Anmeldung.
#CANVAZ_SMTP_HOST=smtp.example.com
#CANVAZ_SMTP_PORT=587
#CANVAZ_SMTP_SECURE=false
#CANVAZ_SMTP_ALLOW_INSECURE=false
#CANVAZ_SMTP_USER=ERSETZEN-Benutzer
#CANVAZ_SMTP_PASSWORD=ERSETZEN-Passwort
#CANVAZ_MAIL_FROM=canvaz@example.com

# Den einzigen Systemadmin legt einmalig `npm run admin:bootstrap -- --name "..." --email "..."` an; der
# Aufruf gibt einen befristeten Einladungslink aus. Es gibt hier bewusst keine Zugangsdaten: kein
# Initialpasswort, kein Adminname, kein Geheimnis.

# Anfragen je Minute und Client auf jeden Pfad unter /api/ (Standard 600, erlaubt 60 bis 600000).
CANVAZ_RATE_LIMIT_PER_MINUTE=600

# Versuche je Minute und Client auf Anmeldung, Passwortwechsel und Einloesen einer Einladung
# (Standard 10, erlaubt 5 bis 600000). Bewusst weit unter der allgemeinen Grenze: hier wird geraten.
CANVAZ_AUTH_RATE_LIMIT_PER_MINUTE=10

# Zusaetzlich je Zielkonto, gleich von wie vielen Absendern: hoechstens so viele Versuche auf Anmeldung und
# Passwortwechsel (Standard 10, erlaubt 3 bis 100000) je Fenster (Standard 15 Minuten, erlaubt 1 bis 1440).
# Die Drosselung endet mit dem Fenster von selbst; eine richtige Anmeldung setzt sie zurueck.
CANVAZ_AUTH_RATE_LIMIT_PER_ACCOUNT=10
CANVAZ_AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Steht ein Reverse Proxy davor? Nur dann zaehlt die Ratengrenze den letzten Eintrag aus `x-forwarded-for`
# statt der Verbindungsadresse. Ohne Proxy waere die Kopfzeile frei erfunden - deshalb Standard false.
CANVAZ_TRUSTED_PROXY=false

# Ablage der Board-Assets: filesystem | s3
CANVAZ_STORAGE_ADAPTER=filesystem

# Obergrenze einer einzelnen Bilddatei in Bytes (Standard 5 MiB, erlaubt 16384 bis 67108864).
CANVAZ_MAX_ASSET_BYTES=5242880

# Nur fuer CANVAZ_STORAGE_ADAPTER=filesystem. Pflichtwert ohne Standard: der Pfad muss ein persistentes
# Volume sein. Ein Verzeichnis im Containerlayer waere beim naechsten Neustart weg.
CANVAZ_STORAGE_FILESYSTEM_ROOT=./var/assets

# Nur fuer CANVAZ_STORAGE_ADAPTER=s3. Alle fuenf sind dann Pflicht; der Server startet sonst nicht.
# MinIO aus compose.yml (Hostport 59000) braucht CANVAZ_S3_FORCE_PATH_STYLE=true.
#CANVAZ_S3_ENDPOINT=http://127.0.0.1:59000
#CANVAZ_S3_REGION=us-east-1
#CANVAZ_S3_BUCKET=canvaz-assets
#CANVAZ_S3_ACCESS_KEY_ID=canvaz
#CANVAZ_S3_SECRET_ACCESS_KEY=ERSETZEN-Secret
#CANVAZ_S3_FORCE_PATH_STYLE=true

# Obergrenze eines gespeicherten Szenen-Snapshots in Bytes (Standard 5 MiB, erlaubt 65536 bis 67108864).
CANVAZ_MAX_SCENE_BYTES=5242880

# Zahl der je Board aufbewahrten Szenenversionen (Standard 100, erlaubt 10 bis 1000). Aeltere Staende fallen
# bei der naechsten Speicherung heraus; eine unbegrenzte Historie gibt es bewusst nicht.
CANVAZ_SCENE_VERSION_RETENTION=100

# Obergrenze einer .excalidraw-Importdatei in Bytes (Standard 20 MiB, erlaubt 65536 bis 134217728). Groesser
# als ein Snapshot, weil die Datei ihre Bilder als Base64 mittraegt.
CANVAZ_MAX_IMPORT_BYTES=20971520
