# Vorlage fuer die lokale Konfiguration: `cp .env.example .env` und Platzhalter ersetzen.
# `.env` ist gitignoriert und darf nie versioniert werden.

# Anwendungsserver
CANVAZ_PORT=3000
CANVAZ_BASE_URL=http://localhost:3000
CANVAZ_WEB_ROOT=dist/web

# PostgreSQL aus compose.yml (Hostport 55432)
DATABASE_URL=postgres://canvaz:canvaz@127.0.0.1:55432/canvaz

# Serverseitige Sessions. Mindestens 32 Zeichen, z. B. `openssl rand -base64 48`.
CANVAZ_SESSION_SECRET=ERSETZEN-durch-ein-zufaelliges-Geheimnis
CANVAZ_SESSION_TTL_HOURS=12

# OIDC-Anbindung. Werte stammen aus der Client-Registrierung beim Identity Provider.
# Die Redirect-URI muss dieselbe Herkunft wie CANVAZ_BASE_URL haben; sonst startet der Server nicht.
# Authentik: Issuer ist die "OpenID Configuration Issuer"-URL der Application, z. B.
# https://authentik.example.com/application/o/canvaz/
CANVAZ_OIDC_ISSUER=https://idp.example.com/realms/canvaz
CANVAZ_OIDC_CLIENT_ID=ERSETZEN-Client-ID
CANVAZ_OIDC_CLIENT_SECRET=ERSETZEN-Client-Secret
CANVAZ_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Ablage der Board-Assets: filesystem | s3
CANVAZ_STORAGE_ADAPTER=filesystem

# Obergrenze einer einzelnen Bilddatei in Bytes (Standard 5 MiB, erlaubt 16384 bis 67108864).
CANVAZ_MAX_ASSET_BYTES=5242880

# Nur fuer CANVAZ_STORAGE_ADAPTER=filesystem. Pflichtwert ohne Standard: der Pfad muss ein persistentes
# Volume sein. Ein Verzeichnis im Containerlayer waere beim naechsten Neustart weg.
CANVAZ_STORAGE_FILESYSTEM_ROOT=./var/assets

# Nur fuer CANVAZ_STORAGE_ADAPTER=s3. Alle fuenf sind dann Pflicht; der Server startet sonst nicht.
# MinIO aus compose.yml (Hostport 59000) braucht CANVAZ_S3_FORCE_PATH_STYLE=true.
#CANVAZ_S3_ENDPOINT=http://127.0.0.1:59000
#CANVAZ_S3_REGION=us-east-1
#CANVAZ_S3_BUCKET=canvaz-assets
#CANVAZ_S3_ACCESS_KEY_ID=canvaz
#CANVAZ_S3_SECRET_ACCESS_KEY=ERSETZEN-Secret
#CANVAZ_S3_FORCE_PATH_STYLE=true

# Obergrenze eines gespeicherten Szenen-Snapshots in Bytes (Standard 5 MiB, erlaubt 65536 bis 67108864).
CANVAZ_MAX_SCENE_BYTES=5242880
