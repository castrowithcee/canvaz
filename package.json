{
  "name": "canvaz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Selbst gehostete Kollaborationsplattform: React/Vite-SPA, HTTP-API und PostgreSQL in einem Deployable.",
  "license": "MIT",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx --env-file-if-exists=.env watch src/server/main.ts",
    "start:server": "tsx --env-file-if-exists=.env src/server/main.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc --project tsconfig.server.json && node --input-type=commonjs --eval \"require('node:fs').cpSync('src/persistence/migrations', 'dist/persistence/migrations', { recursive: true })\"",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:up": "docker compose up --detach --wait postgres minio",
    "db:down": "docker compose down",
    "db:migrate": "tsx --env-file-if-exists=.env src/persistence/migrate-cli.ts",
    "admin:bootstrap": "tsx --env-file-if-exists=.env src/server/bootstrap-cli.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "jose": "^6.2.9",
    "lucide-react": "^1.37.0",
    "nodemailer": "^7.0.13",
    "openid-client": "^6.8.5",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.8.1",
    "globals": "^16.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "^5.1.16",
    "lodash-es": "^4.18.1"
  }
}
